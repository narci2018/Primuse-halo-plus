{
  "name": "primuse-sync-server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Primuse 歌单同步 + 音乐源管理中心（Cloudflare Pages Functions）",
  "scripts": {
    "dev": "wrangler pages dev public",
    "test:match": "node tests/song-match.test.mjs",
    "test:match:mutate": "node tests/song-match.mutations.mjs",
    "test": "node tests/song-match.test.mjs && node tests/cf-contract.test.mjs",
    "test:offline": "node tests/song-match.test.mjs && node tests/cf-contract.test.mjs --no-net",
    "test:runner": "node tests/runner-e2e.mjs",
    "test:all": "node tests/song-match.test.mjs && node tests/cf-contract.test.mjs && node tests/runner-e2e.mjs",
    "deploy": "wrangler pages deploy public --project-name=primuse-sync-server",
    "deploy:runner": "node scripts/deploy-runner.mjs",
    "check:live": "node scripts/check-live.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
