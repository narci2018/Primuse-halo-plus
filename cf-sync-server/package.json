{
  "name": "primuse-sync-server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Primuse 歌单同步 + 音乐源管理中心（Cloudflare Pages Functions）",
  "scripts": {
    "dev": "wrangler pages dev public",
    "test": "node tests/cf-contract.test.mjs",
    "test:offline": "node tests/cf-contract.test.mjs --no-net",
    "test:runner": "node tests/runner-e2e.mjs",
    "test:all": "node tests/cf-contract.test.mjs && node tests/runner-e2e.mjs",
    "deploy": "wrangler pages deploy public --project-name=primuse-sync-server"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
